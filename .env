# API Keys - Replace with your own keys for production
# World Bank API - No key needed
# NASA API - DEMO_KEY works for limited usage, get your own at https://api.nasa.gov/
VITE_NASA_API_KEY=DEMO_KEY
# Alpha Vantage - Get free key at https://www.alphavantage.co/support/#api-key
VITE_ALPHA_VANTAGE_KEY=demo
# TMDB - Get free key at https://www.themoviedb.org/settings/api
VITE_TMDB_KEY=
# OpenWeather - Get free key at https://openweathermap.org/api
VITE_OPENWEATHER_KEY=
